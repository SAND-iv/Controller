{
  "expo": {
    "name": "PC Controller",
    "slug": "pc-controller",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0f1113"
    },
    "android": {
      "package": "com.anonymous.pccontroller",
      "adaptiveIcon": {
        "backgroundColor": "#0f1113"
      }
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.pccontroller"
    },
    "plugins": [
      "react-native-webview"
    ]
  }
}
